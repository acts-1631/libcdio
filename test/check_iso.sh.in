#!@SHELL@

if test -z $srcdir ; then
  srcdir=$(pwd)
fi

if test "X$top_builddir" = "X" ; then
  top_builddir=$(pwd)/..
fi

. ${top_builddir}/test/check_common_fn

if test ! -x ../src/iso-info@EXEEXT@ ; then
  exit 77
fi

BASE=$(basename $0 .sh)
fname=copying

opts="--quiet ${srcdir}/data/${fname}.iso --iso9660 "
test_iso_info  "$opts" ${fname}.dump ${srcdir}/${fname}.right
RC=$?
check_result $RC 'iso-info basic test' "$ISO_INFO $opts"

opts="--ignore --image ${srcdir}/data/${fname}.iso --extract $fname "
test_iso_read  "$opts" ${fname} ${srcdir}/copying.gpl
RC=$?
check_result $RC 'iso-read basic test' "$ISO_READ $opts"

if test -n "@HAVE_ROCK@"; then
  fname=copying-rr
  if test -n "@MINGW32@"; then
      right_file=${fname}-mingw.right
  else
      right_file=${fname}.right
  fi
  opts="--quiet ${srcdir}/data/${fname}.iso --iso9660 "
  test_iso_info  "$opts" ${fname}.dump ${srcdir}/${right_file}
  RC=$?
  check_result $RC 'iso-info Rock Ridge test' "$ISO_INFO $opts"

  opts="--image ${srcdir}/data/${fname}.iso --extract COPYING"
  test_iso_read  "$opts" ${fname} ${srcdir}/copying-rr.gpl
  RC=$?
  check_result $RC 'iso-read RR test' "$ISO_READ $opts"
fi

if test -n "@HAVE_JOLIET@" ; then
  BASE=$(basename $0 .sh)
  fname=joliet
  opts="--quiet ${srcdir}/data/${fname}.iso --iso9660 "
  test_iso_info  "$opts" ${fname}-nojoliet.dump ${srcdir}/${fname}.right
  RC=$?
  check_result $RC 'iso-info Joliet test' "$cmdline"
  opts="--quiet ${srcdir}/data/${fname}.iso --iso9660 --no-joliet "
  test_iso_info  "$opts" ${fname}-nojoliet.dump \
                 ${srcdir}/${fname}-nojoliet.right
  RC=$?
  check_result $RC 'iso-info --no-joliet test' "$cmdline"
fi

for fname in malformed malformed2; do
    opts="--quiet ${srcdir}/data/${fname}.iso -f "
    test_iso_info  "$opts" ${fname}.dump ${srcdir}/${fname}.right
    BAD_RC=$?
    if test $BAD_RC -ne  0 ; then
	check_result 0 "iso-info $fname test" "$cmdline"
    else
	echo "$0: in $fname Expecting nonzero return"
	RC=1
    fi
done

extract_base=/tmp/iso-path-$$
extract_dir=$extract_base/out
bad_iso=$extract_base.iso
escaped_file=$extract_base/escaped.txt
payload=$extract_dir.payload
mkdir "$extract_base"
cp "${srcdir}/data/copying.iso" "$bad_iso"
printf '../escaped.txt' > "$payload"
printf '\060' > "$extract_dir.record-length"
printf '\016' > "$extract_dir.name-length"
dd if="$extract_dir.record-length" of="$bad_iso" bs=1 seek=$((23 * 2048 + 68)) conv=notrunc 2>/dev/null
dd if="$extract_dir.name-length" of="$bad_iso" bs=1 seek=$((23 * 2048 + 68 + 32)) conv=notrunc 2>/dev/null
dd if="$payload" of="$bad_iso" bs=1 seek=$((23 * 2048 + 68 + 33)) conv=notrunc 2>/dev/null
cmd="../example/extract $bad_iso $extract_dir"
$cmd >/dev/null 2>&1
RC=$?
if test -e "$escaped_file" ; then
    echo "$0: extractor wrote outside the ISO destination"
    RC=1
fi
rm -f "$bad_iso" "$payload" "$extract_dir.record-length" "$extract_dir.name-length" "$escaped_file"
if test -d "$extract_base" ; then
    rm -fr "$extract_base"
fi
check_result $RC 'ISO extraction path test' "$cmd"

long_base=${TMPDIR-/tmp}/libcdio-iso-long-path-$$
long_image=$long_base.iso
long_block=$long_base.block
long_name=$long_base.name
long_log=$long_base.log

if command -v dd >/dev/null 2>&1 && test -r /dev/zero; then
put733()
{
    value=$1
    file=$2
    offset=$3
    printf "\\$(printf '%03o' $value)\\000\\000\\000\\000\\000\\000\\$(printf '%03o' $value)" |
        dd of="$file" bs=1 seek=$offset conv=notrunc 2>/dev/null
}

mkdir "$long_base"
dd if=/dev/zero of="$long_image" bs=2048 count=52 2>/dev/null
dd if=/dev/zero of="$long_block" bs=2048 count=1 2>/dev/null
dd if=/dev/zero bs=200 count=1 2>/dev/null | tr '\000' D > "$long_name"
printf '\001CD001\001' | dd of="$long_block" bs=1 seek=0 conv=notrunc 2>/dev/null
put733 52 "$long_block" 80
printf '\042' | dd of="$long_block" bs=1 seek=156 conv=notrunc 2>/dev/null
put733 20 "$long_block" 158
put733 2048 "$long_block" 166
printf '\002\001\000\000\001\001\000' | dd of="$long_block" bs=1 seek=181 conv=notrunc 2>/dev/null
dd if="$long_block" of="$long_image" bs=2048 seek=16 conv=notrunc 2>/dev/null
dd if=/dev/zero of="$long_block" bs=2048 count=1 2>/dev/null
printf '\377CD001\001' | dd of="$long_block" bs=1 seek=0 conv=notrunc 2>/dev/null
dd if="$long_block" of="$long_image" bs=2048 seek=17 conv=notrunc 2>/dev/null

long_i=0
while test $long_i -le 30 ; do
    dd if=/dev/zero of="$long_block" bs=2048 count=1 2>/dev/null
    printf '\042' | dd of="$long_block" bs=1 seek=0 conv=notrunc 2>/dev/null
    put733 $((20 + long_i)) "$long_block" 2
    put733 2048 "$long_block" 10
    printf '\002\001\000\000\001\001\000' | dd of="$long_block" bs=1 seek=25 conv=notrunc 2>/dev/null
    printf '\042' | dd of="$long_block" bs=1 seek=34 conv=notrunc 2>/dev/null
    put733 $((19 + long_i)) "$long_block" 36
    put733 2048 "$long_block" 44
    printf '\002\001\000\000\001\001\000' | dd of="$long_block" bs=1 seek=59 conv=notrunc 2>/dev/null
    printf '\352' | dd of="$long_block" bs=1 seek=68 conv=notrunc 2>/dev/null
    put733 $((21 + long_i)) "$long_block" 70
    if test $long_i -lt 30 ; then
        put733 2048 "$long_block" 78
        printf '\002' | dd of="$long_block" bs=1 seek=93 conv=notrunc 2>/dev/null
    else
        put733 5 "$long_block" 78
    fi
    printf '\001\000\000\001\310' | dd of="$long_block" bs=1 seek=96 conv=notrunc 2>/dev/null
    dd if="$long_name" of="$long_block" bs=1 seek=101 conv=notrunc 2>/dev/null
    dd if="$long_block" of="$long_image" bs=2048 seek=$((20 + long_i)) conv=notrunc 2>/dev/null
    long_i=$((long_i + 1))
done

cmd="../example/extract $long_image $long_base/out"
$cmd > "$long_log" 2>&1
LONG_RC=$?
if test $LONG_RC -eq 0 || ! grep -q 'Image path is too long' "$long_log" ; then
    echo "$0: long ISO path was not rejected before buffer use"
    RC=1
fi
rm -f "$long_image" "$long_block" "$long_name" "$long_log"
if test -d "$long_base" ; then
    rm -fr "$long_base"
fi
check_result ${RC-0} 'bounded ISO extraction path test' "$cmd"
else
    echo "-- $0: bounded ISO extraction path test skipped (dd or /dev/zero unavailable)."
fi


exit $RC

#;;; Local Variables: ***
#;;; mode:shell-script ***
#;;; eval: (sh-set-shell "bash") ***
#;;; End: ***
